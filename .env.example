# Required for live chat. Keep this server-side; never prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Can also be saved from Dashboard -> Integrations.
# Without these values, alerts are recorded locally as "queued".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Google Calendar OAuth. Can also be saved from Dashboard -> Integrations.
# Authorised redirect URI to add in Google Cloud Console:
# http://localhost:3000/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
APP_URL=http://localhost:3000
