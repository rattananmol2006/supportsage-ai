# Required for live chat. Keep this server-side; never prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Can also be saved from Dashboard -> Integrations.
# Without these values, alerts are recorded locally as "queued".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
